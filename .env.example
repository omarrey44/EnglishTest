# Copy to .env.local and fill in from your Supabase project:
#   Dashboard → Project Settings → Data API  (URL)
#   Dashboard → Project Settings → API Keys  (anon / publishable key)
#
# Leave these empty and the app still runs — everyone is a guest and progress
# stays in the browser's localStorage.
#
# Both values are safe to expose to the browser: the anon key only grants what
# Row Level Security allows. Never put the service_role key in a NEXT_PUBLIC_
# variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
